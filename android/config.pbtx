# Perfetto Trace Configuration for Air Mouse Profiling
# File: config.pbtx
# Usage: perfetto -c config.pbtx --txt -o /data/misc/perfetto-traces/trace.perfetto-trace

# One or more buffers to store the trace data.
buffers: {
    size_kb: 65536
    fill_policy: RING_BUFFER
}
buffers: {
    size_kb: 8192
    fill_policy: RING_BUFFER
}

# Duration of the trace session.
duration_ms: 10000

data_sources: {
    config {
        name: "linux.ftrace"
        target_buffer: 0
        ftrace_config {
            # CPU Scheduling & Context Switches
            ftrace_events: "sched/sched_switch"
            ftrace_events: "sched/sched_wakeup"
            ftrace_events: "sched/sched_waking"
            
            # CPU Frequency & Power Management
            ftrace_events: "power/cpu_frequency"
            ftrace_events: "power/cpu_idle"
            ftrace_events: "power/suspend_resume"
            
            # Workqueue events to trace deferred execution
            ftrace_events: "workqueue/workqueue_execute_start"
            ftrace_events: "workqueue/workqueue_execute_end"

            # Android user-space tracing (Trace.beginSection / atrace)
            ftrace_events: "ftrace/print"
            
            # Enable specific atrace categories for UI and system events
            atrace_categories: "gfx"
            atrace_categories: "view"
            atrace_categories: "wm"
            atrace_categories: "input"
            atrace_categories: "freq"
            atrace_categories: "sched"
            atrace_categories: "power"
            
            # Enable custom tracing for the Air Mouse application
            atrace_apps: "com.airmouse"
        }
    }
}

# Track process/thread associations & associations names.
data_sources: {
    config {
        name: "linux.process_stats"
        target_buffer: 1
        process_stats_config {
            proc_stats_poll_ms: 1000
        }
    }
}

# Track system CPU usage statistics.
data_sources: {
    config {
        name: "linux.sys_stats"
        target_buffer: 1
        sys_stats_config {
            stat_period_ms: 1000
        }
    }
}

# Optional: Track Android power and battery status.
data_sources: {
    config {
        name: "android.power"
        target_buffer: 1
        android_power_config {
            battery_poll_ms: 1000
            collect_power_rails: true
        }
    }
}
